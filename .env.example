# Copy to .env.local and change what you need. EXPO_PUBLIC_* values are built into the app.

# The SmartBin API. Leave unset in local development: phones then use the computer running
# Metro (same Wi-Fi), port 3000; the web build uses http://localhost:3000/v1.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000/v1

# "dev" = local sign-in (the token is the email; the API needs AUTH_MODE=dev). Anything else = Cognito (not wired yet).
EXPO_PUBLIC_AUTH_MODE=dev

# The SmartBin web app, for the privacy policy link
EXPO_PUBLIC_SITE_URL=http://localhost:3001

# Maps: Amazon Location when a key is set, OpenFreeMap otherwise (and if Amazon fails)
# EXPO_PUBLIC_AWS_MAP_KEY=v1.public....
# EXPO_PUBLIC_AWS_REGION=ap-south-1
# EXPO_PUBLIC_AWS_MAP_STYLE=Monochrome
# EXPO_PUBLIC_MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
# EXPO_PUBLIC_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark

# Walking directions when Amazon Routes isn't available (FOSSGIS community server, fair use)
# EXPO_PUBLIC_OSM_ROUTING_URL=https://routing.openstreetmap.de/routed-foot
